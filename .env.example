# Required — web app and worker. See supabase/README.md and docs/DEPLOYMENT.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required by the worker; required by the web app only for
# minting signed audio URLs (src/lib/db/audioAssets.ts). Never expose to the
# browser — see docs/SECURITY.md "Secrets".
SUPABASE_SERVICE_ROLE_KEY=

# Optional — web app.
# Canonical origin used to build absolute URLs in src/app/sitemap.ts. Falls
# back to Vercel's own VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Set to 1 to make a production boot (NODE_ENV=production) fail loudly
# instead of degrading when Supabase env vars are missing — see
# scripts/check-env.ts. Already implied when VERCEL is set (Vercel sets that
# automatically), so this is only needed for a non-Vercel production host.
REQUIRE_SUPABASE=

# Optional — worker only (scripts/worker.ts). Defaults documented in that
# file's header comment.
FFMPEG_PATH=
FFPROBE_PATH=
WORKER_POLL_INTERVAL_MS=
WORKER_BATCH_SIZE=
# Where the worker reaches the Python DSP sidecar (src/lib/audio/sidecarPipeline.ts).
# Defaults to http://127.0.0.1:8011 when unset — only needed when the sidecar
# runs on a separate host from the worker. Set all three together or not at
# all (npm run check-env:groups asserts this): a partially-set group means
# pitch_snap/self_harmony jobs fail and retry forever with no local fallback
# (scripts/worker.ts).
SIDECAR_URL=
SIDECAR_TIMEOUT_MS=
SIDECAR_RETRIES=
# scripts/run-sidecar.mjs only — host/port the sidecar's own HTTP server
# binds to. Independent of SIDECAR_URL above (which is how the WORKER finds
# it); only relevant when running the sidecar itself.
SIDECAR_HOST=
SIDECAR_PORT=
# Path to the RNNoise model file the sidecar loads for noise suppression.
# Defaults to sidecar/models/rnnoise.rnnn (relative to the process cwd) when unset.
RNNOISE_MODEL_PATH=

# Required by npm run db:migrate (scripts/apply-migrations.ts) only — a
# direct Postgres connection string (Supabase project settings → Database →
# Connection string), never used by the web app or worker at runtime.
# DATABASE_URL takes precedence; SUPABASE_DB_URL is the fallback name.
DATABASE_URL=
SUPABASE_DB_URL=

# Optional — e2e only. Set to 1 to include the backend-dependent Playwright
# specs (see playwright.config.ts, docs/TESTING.md); requires .env.local to
# point at a real throwaway Supabase project.
E2E_SUPABASE=

# Optional — web app. Web Push for Duet request/answer and open-call-answer
# notifications (src/lib/push/send.ts). Push notifications are silently
# disabled (no throw, no crash) when any of these three are unset. Generate a
# pair with `npx web-push generate-vapid-keys` — see docs/DEPLOYMENT.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A "mailto:" address or "https:" URL identifying who to contact about this
# VAPID identity, per the Web Push protocol.
VAPID_SUBJECT=

# Optional — web app. AKINTI Pro subscriptions (Wave F, docs/BILLING.md).
# iyzico is primary (TR cards/TRY pricing); Paddle is secondary (international
# cards/USD pricing, merchant of record). Both degrade to a clear "checkout
# unavailable" error when unset — never a crash — but startProCheckout for a
# plan on that provider will fail until its variables are set.
#
# iyzico (docs.iyzico.com — sandbox keys from the Merchant/Sandbox panel).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Defaults to the sandbox API when unset. Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Numeric merchant id from the iyzico panel — required only to verify the
# X-IYZ-SIGNATURE-V3 webhook signature (docs/BILLING.md "iyzico webhooks");
# not the same value as IYZICO_API_KEY.
IYZICO_MERCHANT_ID=
#
# Paddle Billing (vendors.paddle.com — Developer Tools → Authentication).
PADDLE_API_KEY=
# Developer Tools → Notifications → your webhook destination's secret key.
PADDLE_WEBHOOK_SECRET=
# "sandbox" or "production" — defaults to sandbox when unset.
PADDLE_ENVIRONMENT=sandbox
# Public — passed to Paddle.js on the client for the hosted checkout overlay
# (settings/pro, `src/components/pro/`).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" or "production" — Paddle.js's own `Paddle.Environment.set()` needs
# this client-side too, separately from the server-only PADDLE_ENVIRONMENT
# above. Defaults to sandbox when unset.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Optional — `scripts/seed-plans.ts` (docs/BILLING.md "Seeding plans"). Real
# provider price/pricing-plan reference ids, created by hand in each
# provider's dashboard first — never fabricated. A plan whose id is unset is
# skipped, not inserted with a placeholder.
IYZICO_PLAN_MONTHLY_TRY=
IYZICO_PLAN_YEARLY_TRY=
PADDLE_PRICE_MONTHLY_USD=
PADDLE_PRICE_YEARLY_USD=
# The two monthly plans use the founder's already-decided prices (PRODUCT_V2
# §5/§6: ₺79.99/month, $4.99/month) directly — no env var needed. The annual
# discount is NOT decided yet, so each yearly plan additionally needs its own
# real minor-unit amount (kuruş / cents) here before it will seed.
IYZICO_PLAN_YEARLY_TRY_AMOUNT=
PADDLE_PRICE_YEARLY_USD_AMOUNT=
