{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "worker:once": "tsx --env-file-if-exists=.env.local scripts/worker.ts --once",
    "sidecar": "node scripts/run-sidecar.mjs",
    "seed:backing-tracks": "tsx --env-file-if-exists=.env.local scripts/seed-backing-tracks.ts",
    "check-env": "tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "check-env:worker": "tsx --env-file-if-exists=.env.local scripts/check-env.ts --worker",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/apply-migrations.ts",
    "db:migrate:dry": "tsx --env-file-if-exists=.env.local scripts/apply-migrations.ts --dry-run",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/apply-migrations.ts --seed",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "clsx": "^2.1.1",
    "extendable-media-recorder": "^9.2.40",
    "extendable-media-recorder-wav-encoder": "^7.0.140",
    "idb-keyval": "^6.3.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "pitchy": "^4.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
